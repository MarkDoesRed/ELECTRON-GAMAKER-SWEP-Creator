{
  "name": "gmwmaker",
  "version": "1.0.0",
  "description": "A custom SWEP generator for Garry's Mod",
  "main": "main.js",
  "author": "MNCE TV",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },
  "build": {
    "appId": "com.mncetv.gmwmaker",
    "productName": "GMWMaker",
    "win": {
      "icon": "icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.13.3"
  }
}
